# AutoCon Backend Configuration Template
# DO NOT COMMIT ACTUAL SECRETS TO SOURCE CONTROL

# Server Setup
PORT=5000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database Connection (MongoDB URI)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/autocon?retryWrites=true&w=majority

# Security (MUST BE AT LEAST 32 CHARS IN PRODUCTION)
JWT_SECRET=super_secret_development_key_change_me_in_production_123

# Web3 / Smart Contract Integration
# RPC endpoints are required for backend contract health verification checks
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
AMOY_RPC_URL=https://rpc-amoy.polygon.technology
BNB_TESTNET_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_KEY

# Pinata IPFS Integration (Required for uploading templates / NFT metadata)
PINATA_JWT=your_pinata_jwt_token_here

# Background Workers (Redis)
# REDIS_HOST is required unless USE_IN_MEMORY_QUEUE=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password
REDIS_TLS=false
USE_IN_MEMORY_QUEUE=false

# Observability / Error Tracking
SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# AI / Chat Integration (Gemini, OpenAI, etc)
GEMINI_API_KEY=AIzaSy...
AI_LIMIT_RPM=5
AI_LIMIT_RPD=50

